# Telegram — bot must be an admin of the channel with "Post Messages" permission
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather
# "@channelusername" for public channels, or numeric ID like -1001234567890 (preferred for private)
TELEGRAM_CHANNEL_ID=@your_channel_username

# MCP server auth — Claude sends this as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32   (min 32 characters)
MCP_AUTH_TOKEN=replace-with-a-long-random-secret-of-32-plus-chars

# Server (PORT is injected automatically by Render)
PORT=3000
LOG_LEVEL=info

# Optional persistence (post history + schedule queue survive restarts).
# Create a free DB at https://upstash.com → REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=